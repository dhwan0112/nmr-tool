# Run from the repository root with the export in data/ (not tracked).
load "data/CM3191-Week 10-Thurs-5TBI-Oct22-2026-R09.zip" alcohols
ref
baseline offset
integrate 3.42 3.62 name=trans nh=1
integrate 3.98 4.10 name=cis nh=1
integrate 0.80 0.90 name=tBu nh=9
label 3.51 H-1 axial
label 4.03 H-1 equatorial
label 0.85 C(CH₃)₃
plot 3.35 4.2 0.7 2.2 out=examples/cm3191/organic-3-borohydride-reduction/carbinol.png
